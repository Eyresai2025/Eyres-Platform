# EYRES AI Inspection Platform configuration
# Copy this file to .env and fill in the Google values.
# Existing Windows environment variables override values in .env.

EYRES_APP_NAME=EYRES AI Inspection Platform
EYRES_ENV=production
EYRES_DATA_DIR=C:\EyresAI_Data
EYRES_LOG_DIR=C:\EyresAI_Data\logs
EYRES_MONGODB_URI=mongodb://localhost:27017
EYRES_MONGODB_DATABASE=eyres_qc
EYRES_SERVICE_TIMEOUT_MS=2000
EYRES_NAVIGATION_DEBOUNCE_MS=75

# Required only for first-run creation of the bootstrap admin.
# Remove it after the admin account has been provisioned.
EYRES_BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-run

# Google OAuth 2.0 Desktop Application
# Create this as a Desktop app OAuth client in Google Cloud.
# Never commit a real credential file or secret to source control.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
